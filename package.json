{
  "name": "6w7",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "game:build": "tsc -p game-server/tsconfig.json",
    "game:start": "node --env-file-if-exists=.env.game build/game/game-server/index.js",
    "game:dev": "npm run game:build && npm run game:start",
    "game:test": "npm run game:build && node --test build/game/game-server/tests/*.test.js",
    "setup": "npm ci && prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
