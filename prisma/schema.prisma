// 6w7 — Prisma schema（見 AGENTS.md §4）
// 本機／正式皆 PostgreSQL（Neon 或同等）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
}

enum UserRole {
  user
  admin
}

enum MessageStatus {
  visible
  hidden
  flagged
  deleted
}

model User {
  id            String     @id @default(cuid())
  /// Instagram ID 風格，唯一；公開連結 = /{username}
  username      String     @unique
  email         String?    @unique
  emailVerified DateTime?
  name          String?
  /// 頭貼公開路徑或完整 URL（本機 /uploads/...；正式 R2 公開網址）
  image         String?
  passwordHash  String?
  status        UserStatus @default(active)
  role          UserRole   @default(user)
  /// 公開示範帳號（真實 User，可登入／登出；全站可辨識）
  isDemo        Boolean    @default(false)
  /// 最近一次語言（裝置推斷或本人選擇）。信件可用此值。示範帳號不寫。
  locale        String?
  /// 使用者曾在頁尾自行切換語言。為 true 時登入必須立刻套用 locale，UI 不再跟裝置。
  localeChosen  Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts            Account[]
  sessions            Session[]
  askLink             AskLink?
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
  mediaAssets         MediaAsset[]
}

/// 忘記密碼：只存 token 雜湊，明文只出現在信件連結
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 信箱驗證：只存 token 雜湊
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// 每人一條；slug 恒等於 username
model AskLink {
  id                String    @id @default(cuid())
  userId            String    @unique
  slug              String    @unique
  title             String    @default("匿名問我")
  prompt            String    @default("匿名傳訊息給我！")
  isActive          Boolean   @default(true)
  acceptingMessages Boolean   @default(true)
  theme             String?
  expiresAt         DateTime?
  dailyLimit        Int?
  requireTopic      Boolean   @default(false)
  topics            Json      @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  blocks   BlockRule[]
  stickers PageSticker[]
}

model Message {
  id              String        @id @default(cuid())
  linkId          String
  body            String
  topic           String?
  status          MessageStatus @default(visible)
  isRead          Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  isArchived      Boolean       @default(false)
  fingerprintHash String?
  createdAt       DateTime      @default(now())

  link    AskLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([linkId, createdAt])
  @@index([fingerprintHash])
}

model Report {
  id        String   @id @default(cuid())
  messageId String
  reason    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model BlockRule {
  id              String   @id @default(cuid())
  linkId          String
  fingerprintHash String?
  keyword         String?
  createdAt       DateTime @default(now())

  link AskLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

/// 公開頁裝扮用的圖片庫（每人獨立目錄，刪除時連檔案一起刪）
model MediaAsset {
  id        String   @id @default(cuid())
  userId    String
  objectKey String
  url       String
  width     Int
  height    Int
  bytes     Int
  createdAt DateTime @default(now())
  /// 示範帳號裝扮圖到期時間；一般帳號為 null（不過期）
  expiresAt DateTime?
  /// 示範沙盒（cookie `6w7_demo_sandbox`）；一般帳號為 null
  sandboxId String?

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickers  PageSticker[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([userId, sandboxId])
}

/// 貼在公開頁上的一張圖（同一媒體可出現多次）
model PageSticker {
  id        String   @id @default(cuid())
  linkId    String
  assetId   String
  /// 中心點，相對於舞台寬高的百分比 0–100
  x         Float
  y         Float
  scale     Float    @default(1)
  rotation  Float    @default(0)
  zIndex    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  link  AskLink    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([linkId, zIndex])
}
