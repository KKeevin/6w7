# 複製為 .env 後即可本機開發：
#   cp .env.example .env
#   （Windows PowerShell）Copy-Item .env.example .env
#
# 正式環境／多人共用伺服器請務必更換 AUTH_SECRET、FINGERPRINT_SALT。

# —— PostgreSQL（本機／正式皆必填）——
# Neon：Dashboard → Connection string（建議 pooled + sslmode=require）
# 本機 Docker 範例：postgresql://postgres:postgres@localhost:5432/6w7
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/6w7?sslmode=require"

# 頭貼：本機寫入 public/uploads/{userId}/profile.png（該目錄已 gitignore）
# 公開頁貼紙：public/uploads/{userId}/stickers/{id}.webp
STORAGE_DRIVER="local"
# UPLOAD_ROOT=   # 可選；預設 public/uploads

# —— 正式：Cloudflare R2（S3 相容）——
# STORAGE_DRIVER="s3"
# S3_BUCKET="6w7-avatars"
# S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION="auto"
# 公開讀取基底（無尾隨 /），物件 key = avatars/{userId}/profile.png
# S3_PUBLIC_BASE_URL="https://cdn.6w7.link"
# 或 R2 r2.dev 公開網域：https://pub-xxxx.r2.dev
# 建議自訂 CDN 網域（同一 Cloudflare 帳號綁 R2 Custom Domain）：
# S3_PUBLIC_BASE_URL="https://cdn.6w7.link"
# 正式（Vercel）建議加 R2 權杖的 cfat_，走 Cloudflare API 上傳較穩：
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Auth.js — 本機可先用下列值；上線請 `openssl rand -base64 32` 重產
AUTH_SECRET="dev-only-change-me-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# 生產：AUTH_URL="https://6w7.link"

# Google OAuth（選用；未設定時可用帳密）
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Upstash Redis 限流（正式必填；未設定時記憶體限流，僅適合本機單人）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 指紋雜湊鹽 — 上線請更換
FINGERPRINT_SALT="dev-fingerprint-salt-change-me"

# —— 寄信（忘記密碼；Gmail 代發 service@6w7.link）——
# Gmail 需開啟兩步驟驗證，並產「應用程式密碼」填到 SMTP_PASS
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-gmail@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# MAIL_FROM="6w7 <service@6w7.link>"

# 示範帳號 @lewanq 的登入密碼（「進入示範帳號」會用這組建立／登入真實 User）
# DEMO_ACCOUNT_PASSWORD="lewanq-demo-6w7"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 生產：NEXT_PUBLIC_SITE_URL="https://6w7.link"

# —— 廣告（Google AdSense）——
# 正式：Vercel Production 必填 client，才過「驗證網站擁有權」
# NEXT_PUBLIC_ADS_ENABLED="true"
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-xxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_ADSENSE_SLOT_SIDE="0000000000"
# NEXT_PUBLIC_ADSENSE_SLOT_MOBILE="0000000000"
# public/ads.txt 須可開 https://6w7.link/ads.txt
