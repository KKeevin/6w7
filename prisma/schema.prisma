// 6w7 — Prisma schema（見 AGENTS.md §4）
// 本機／正式皆 PostgreSQL（Neon 或同等）
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
}

enum UserRole {
  user
  admin
}

enum MessageStatus {
  visible
  hidden
  flagged
  deleted
}

model User {
  id            String     @id @default(cuid())
  /// Instagram ID 風格，唯一；公開連結 = /{username}
  username      String     @unique
  email         String?    @unique
  emailVerified DateTime?
  name          String?
  /// 頭貼公開路徑或完整 URL（本機 /uploads/...；正式 R2 公開網址）
  image         String?
  passwordHash  String?
  status        UserStatus @default(active)
  role          UserRole   @default(user)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts Account[]
  sessions Session[]
  askLink  AskLink?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// 每人一條；slug 恒等於 username
model AskLink {
  id                String    @id @default(cuid())
  userId            String    @unique
  slug              String    @unique
  title             String    @default("匿名問我")
  prompt            String    @default("匿名傳訊息給我！")
  isActive          Boolean   @default(true)
  acceptingMessages Boolean   @default(true)
  theme             String?
  expiresAt         DateTime?
  dailyLimit        Int?
  requireTopic      Boolean   @default(false)
  topics            Json      @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  blocks   BlockRule[]
}

model Message {
  id              String        @id @default(cuid())
  linkId          String
  body            String
  topic           String?
  status          MessageStatus @default(visible)
  isRead          Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  isArchived      Boolean       @default(false)
  fingerprintHash String?
  createdAt       DateTime      @default(now())

  link    AskLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([linkId, createdAt])
  @@index([fingerprintHash])
}

model Report {
  id        String   @id @default(cuid())
  messageId String
  reason    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model BlockRule {
  id              String   @id @default(cuid())
  linkId          String
  fingerprintHash String?
  keyword         String?
  createdAt       DateTime @default(now())

  link AskLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}
